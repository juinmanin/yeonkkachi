# Environment variables for Yeonkkachi AI Trading Bot
# Copy this file to .env and fill in your credentials.
#
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control – it is listed in .gitignore.

# ── Twitter / X API credentials ────────────────────────────────────────────
# Obtain these from https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=your_api_key_here
TWITTER_API_SECRET=your_api_secret_here
TWITTER_ACCESS_TOKEN=your_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_access_token_secret_here
TWITTER_BEARER_TOKEN=your_bearer_token_here

# ── Risk management ─────────────────────────────────────────────────────────
# Maximum USD value of a single trade (default: 100)
MAX_POSITION_SIZE_USD=100

# Maximum allowed drawdown as a percentage (default: 5)
MAX_DRAWDOWN_PCT=5

# ── Data / logging ───────────────────────────────────────────────────────────
# Optional: override the path where trade logs are written.
# TRADE_LOG_PATH=data/trade_log.json
